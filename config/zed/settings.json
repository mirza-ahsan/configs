{
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "git_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "search": {
    "button": false
  },
  "disable_ai": true,
  "icon_theme": "Warm Charmed Icons",
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "ruff"],
      "completions": { "words_min_length": 1 },
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }],
      "preferred_line_length": 110
    },
    "C++": {
      "language_servers": ["clangd"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "clangd" } }]
    },
    "C": {
      "language_servers": ["clangd"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "clangd" } }]
    },
    "Go": {
      "language_servers": ["gopls"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "gopls" } }]
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "prettier" } }]
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "prettier" } }]
    }
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": "pyrefly",
        "arguments": ["lsp"]
      },
      "initialization_options": {
        "pyrefly": {
          "typeCheckingMode": "basic",
          "analysis": {
            "autoImportCompletions": false,
            "completeFunctionParens": true,
            "showHoverGoToLinks": true,
            "inlayHints": {
              "variableTypes": true,
              "functionReturnTypes": true,
              "callArgumentNames": "off",
              "pytestParameters": false
            }
          }
        }
      }
    }
  },
  "vim": {
    "cursor_shape": {
      "insert": "inherit"
    },
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never"
  },
  "vim_mode": true,
  "vertical_scroll_margin": 8,
  "relative_line_numbers": "enabled",
  "minimap": {
    "max_width_columns": 100
  },
  "code_lens": "on",
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Catppuccin Espresso (Blur)"
  },
  "theme_overrides": {
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "panel.focused_border": "#4E466E",
      "syntax": {
        "comment": {
          "font_style": "italic"
        },
        "comment.doc": {
          "font_style": "italic"
        }
      }
    }
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
    "show_menus": false
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "project_panel": {
    "dock": "right",
    "default_width": 390,
    "hide_hidden": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false
  },
  "scrollbar": {
    "show": "never",
    "git_diff": false
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "selection_highlight": false,
  "inline_code_actions": false,
  "format_on_save": "on",
  "ensure_final_newline_on_save": false,
  "extend_comment_on_newline": false,
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "restore_on_startup": "launchpad",
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false
    }
  },
  "current_line_highlight": "none"
}
