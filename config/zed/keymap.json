[
  {
    "context": "Workspace && !(vim_mode == insert)",
    "bindings": {
      "ctrl-shift-e": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "vim_mode == operator",
    "bindings": {
      "g o": "vim::StartOfDocument"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "g o": ["workspace::SendKeystrokes", "g g 0"],
      "ctrl-shift-v": "editor::Paste"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "K": "editor::Hover",
      "ctrl-_": "zed::OpenLog",
      "- -": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "ctrl-shift-e": "workspace::ToggleRightDock",
      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space f": "editor::Format",
      "space p f": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space p v": "workspace::ToggleLeftDock",
      "space s v": "pane::SplitRight",
      "space s h": "pane::SplitDown",
      "space s x": "pane::CloseActiveItem",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "space r n": "editor::Rename",
      "g r": "editor::FindAllReferences"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp"
    }
  }
]
